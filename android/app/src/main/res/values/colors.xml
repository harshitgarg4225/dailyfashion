<?xml version="1.0" encoding="utf-8"?>
<!--
    The app's own paper and ink. The launch theme, status bar and splash all
    read from here, so the native shell never flashes a colour the interface
    does not use — which is the single most common way a wrapped web app
    announces that it is a wrapped web app.
-->
<resources>
    <color name="colorPrimary">#FFFFFF</color>
    <color name="colorPrimaryDark">#FFFFFF</color>
    <color name="colorAccent">#111111</color>
    <color name="ic_launcher_background">#FFFFFF</color>
    <color name="splashBackground">#FFFFFF</color>
</resources>
